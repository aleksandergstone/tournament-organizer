# Normalize text files to LF in the repository, native line endings on checkout.
* text=auto eol=lf

# PowerShell scripts: CRLF on Windows checkouts (Windows PowerShell is happiest).
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated artifacts — never line-ending translated.
build/icon.png binary
build/icon.ico binary
*.exe binary
*.dmg binary
*.blockmap binary
