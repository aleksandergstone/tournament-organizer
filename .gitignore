# Dependencies
node_modules/

# Build output (vite bundle + electron-builder artifacts) — regenerated by
# `npm run build` / `npm run dist`, never committed.
dist/
release/

# Logs & scratch files
logs/
*.log
npm-debug.log*

# Test coverage
coverage/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local secrets (never used by the app, kept out of history just in case)
.env
.env.*

# NOTE: build/icon.png, build/icon.ico and build/make-icon.ps1 ARE tracked on
# purpose — the icons are required by electron-builder on Linux/macOS CI
# runners, where the PowerShell generator cannot run.
