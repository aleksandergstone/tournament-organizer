# Dependencies
node_modules/

# Build output (vite bundle + electron-builder artifacts) — regenerated by
# `npm run build` / `npm run dist`, never committed.
dist/
release/

# Logs & scratch files
logs/
*.log
npm-debug.log*

# Generated demo data for screenshots (regenerate with `npm run screenshots`)
.cache/

# Test coverage
coverage/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local secrets (never used by the app, kept out of history just in case)
.env
.env.*

# NOTE: build/icon.png, build/icon.ico and build/make-icon.ps1 ARE tracked on
# purpose — the icons are required by electron-builder on Linux/macOS CI
# runners, where the PowerShell generator cannot run.

# Android build toolchain installed by scripts/setup-android-toolchain.ps1
tools/
cap*.log
t.txt
v.txt
b.txt
p.txt
s-out.txt
s-err.txt
tools-setup.log
tools-setup.err
