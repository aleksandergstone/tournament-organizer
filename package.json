{
  "name": "tournament-organizer",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop-first offline-first tournament & league organizer",
  "license": "MIT",
  "author": "Tournament Organizer contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron .",
    "version:check": "node scripts/check-version.mjs",
    "release:check": "npm run version:check && npm run test && npm run build",
    "screenshots": "npm run build && node scripts/make-demo-project.mjs && electron scripts/screenshots.cjs",
    "dist": "npm run release:check && electron-builder --publish never",
    "dist:win": "npm run release:check && electron-builder --win --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.tournamentorganizer.desktop",
    "productName": "Tournament Organizer",
    "copyright": "MIT — free for everyone, offline by design",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "Tournament-Organizer-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tournament Organizer"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.sports",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Sports",
      "icon": "build/icon.png"
    }
  }
}
